# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Alert Channel Integration
BOT_ACCESS_TOKEN="your_bot_access_token_here"
BOT_CHAT_ID="-100123456789"

# Whois / Domain Intelligence API (api.who.is / whois.com)
WHOIS_API_KEY="your_whois_api_key_here"

# Database & Storage Remote Replication
NEXT_PUBLIC_DB_URL="https://corp-internal-storage.net"
DB_SERVICE_KEY="sec_live_99f2b847a19c4d21e8"

# Mailjet Transactional v3.1 REST API
MAILJET_API_KEY="your_mailjet_api_key_here"
MAILJET_SECRET_KEY="your_mailjet_secret_key_here"
MAILJET_SENDER_EMAIL="alerts@yourdomain.com"
MAILJET_SENDER_NAME="DomainPulse Operations"

# Optional Aliases:
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_CHAT_ID="@your_channel_or_group"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

